<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 毛玻璃（亚克力）主题：半透明色 + DWM 模糊背景，窗口为不透明窗口（AllowsTransparency=False） -->
    <Color x:Key="PrimaryColor">#4C8DFF</Color>
    <Color x:Key="PrimaryLightColor">#6BA0FF</Color>
    <Color x:Key="PrimaryDarkColor">#3570DB</Color>
    <Color x:Key="AccentColor">#4C8DFF</Color>
    <Color x:Key="AccentLightColor">#6BA0FF</Color>

    <Color x:Key="SuccessColor">#4FD79B</Color>
    <Color x:Key="WarningColor">#E9AE4E</Color>
    <Color x:Key="ErrorColor">#EC7168</Color>
    <Color x:Key="InfoColor">#6BA0FF</Color>
    <Color x:Key="SignalExcellentColor">#4FD79B</Color>
    <Color x:Key="SignalGoodColor">#95DC77</Color>
    <Color x:Key="SignalFairColor">#E9AE4E</Color>
    <Color x:Key="SignalWeakColor">#EC7168</Color>

    <!-- 半透明：越上层越不透明，形成层次 -->
    <Color x:Key="BackgroundColor">#66101216</Color>
    <Color x:Key="CardColor">#8C16161C</Color>
    <Color x:Key="SurfaceColor">#A6202028</Color>
    <Color x:Key="BorderColor">#33FFFFFF</Color>
    <Color x:Key="DividerColor">#1FFFFFFF</Color>

    <Color x:Key="TextPrimaryColor">#F5F5F8</Color>
    <Color x:Key="TextSecondaryColor">#B4B4C0</Color>
    <Color x:Key="TextDisabledColor">#80808C</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLightColor}"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>
    <SolidColorBrush x:Key="SignalExcellentBrush" Color="{StaticResource SignalExcellentColor}"/>
    <SolidColorBrush x:Key="SignalGoodBrush" Color="{StaticResource SignalGoodColor}"/>
    <SolidColorBrush x:Key="SignalFairBrush" Color="{StaticResource SignalFairColor}"/>
    <SolidColorBrush x:Key="SignalWeakBrush" Color="{StaticResource SignalWeakColor}"/>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}"/>

    <SolidColorBrush x:Key="PrimaryGradientBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="AccentGradientBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="CardGradientBrush" Color="{StaticResource CardColor}"/>
    <SolidColorBrush x:Key="TitleGradientBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="WindowGradientBrush" Color="{StaticResource BackgroundColor}"/>

    <!-- 外壳：铺满窗口、无圆角外扩（圆角由 DWM 提供），无自绘阴影 -->
    <SolidColorBrush x:Key="WindowSolidBrush" Color="#F0121218"/>
    <SolidColorBrush x:Key="WindowBrush" Color="{StaticResource BackgroundColor}"/>
    <Thickness x:Key="ShellMargin">0</Thickness>
    <CornerRadius x:Key="ShellRadius">0</CornerRadius>
    <DropShadowEffect x:Key="ShellEffect" BlurRadius="0" ShadowDepth="0" Opacity="0" Color="Black"/>
</ResourceDictionary>
