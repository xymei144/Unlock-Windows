<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 浅色主题 -->
    <Color x:Key="PrimaryColor">#2F6BFF</Color>
    <Color x:Key="PrimaryLightColor">#4C85FF</Color>
    <Color x:Key="PrimaryDarkColor">#1F55D6</Color>
    <Color x:Key="AccentColor">#2F6BFF</Color>
    <Color x:Key="AccentLightColor">#4C85FF</Color>

    <Color x:Key="SuccessColor">#12A150</Color>
    <Color x:Key="WarningColor">#B4780F</Color>
    <Color x:Key="ErrorColor">#D93B30</Color>
    <Color x:Key="InfoColor">#2F6BFF</Color>
    <Color x:Key="SignalExcellentColor">#12A150</Color>
    <Color x:Key="SignalGoodColor">#5FA800</Color>
    <Color x:Key="SignalFairColor">#B4780F</Color>
    <Color x:Key="SignalWeakColor">#D93B30</Color>

    <Color x:Key="BackgroundColor">#F4F4F7</Color>
    <Color x:Key="CardColor">#FFFFFF</Color>
    <Color x:Key="SurfaceColor">#EFEFF3</Color>
    <Color x:Key="BorderColor">#DFDFE6</Color>
    <Color x:Key="DividerColor">#EAEAEF</Color>

    <Color x:Key="TextPrimaryColor">#17171C</Color>
    <Color x:Key="TextSecondaryColor">#5B5B66</Color>
    <Color x:Key="TextDisabledColor">#94949E</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLightColor}"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>
    <SolidColorBrush x:Key="SignalExcellentBrush" Color="{StaticResource SignalExcellentColor}"/>
    <SolidColorBrush x:Key="SignalGoodBrush" Color="{StaticResource SignalGoodColor}"/>
    <SolidColorBrush x:Key="SignalFairBrush" Color="{StaticResource SignalFairColor}"/>
    <SolidColorBrush x:Key="SignalWeakBrush" Color="{StaticResource SignalWeakColor}"/>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}"/>

    <SolidColorBrush x:Key="PrimaryGradientBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="AccentGradientBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="CardGradientBrush" Color="{StaticResource CardColor}"/>
    <SolidColorBrush x:Key="TitleGradientBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="WindowGradientBrush" Color="{StaticResource BackgroundColor}"/>

    <SolidColorBrush x:Key="WindowSolidBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="WindowBrush" Color="{StaticResource BackgroundColor}"/>
    <Thickness x:Key="ShellMargin">10</Thickness>
    <CornerRadius x:Key="ShellRadius">12</CornerRadius>
    <DropShadowEffect x:Key="ShellEffect" BlurRadius="16" ShadowDepth="0" Opacity="0.20" Color="Black"/>
</ResourceDictionary>
