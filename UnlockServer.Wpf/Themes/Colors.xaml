<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         极简暗色配色
         原则：中性灰阶 + 单一强调色；不用渐变；靠层级而非装饰区分区域
         ============================================================ -->

    <!-- 强调色（全应用唯一强调色） -->
    <Color x:Key="PrimaryColor">#3D7DFF</Color>
    <Color x:Key="PrimaryLightColor">#5C92FF</Color>
    <Color x:Key="PrimaryDarkColor">#2C63D6</Color>

    <!-- 语义色 -->
    <Color x:Key="AccentColor">#3D7DFF</Color>
    <Color x:Key="AccentLightColor">#5C92FF</Color>

    <Color x:Key="SuccessColor">#3FCF8E</Color>
    <Color x:Key="WarningColor">#E3A33C</Color>
    <Color x:Key="ErrorColor">#E5645C</Color>
    <Color x:Key="InfoColor">#5C92FF</Color>

    <Color x:Key="SignalExcellentColor">#3FCF8E</Color>
    <Color x:Key="SignalGoodColor">#8BD46A</Color>
    <Color x:Key="SignalFairColor">#E3A33C</Color>
    <Color x:Key="SignalWeakColor">#E5645C</Color>

    <!-- 中性层级：窗口 → 卡片 → 输入/悬停 → 描边 → 分隔线 -->
    <Color x:Key="BackgroundColor">#0F0F12</Color>
    <Color x:Key="CardColor">#151519</Color>
    <Color x:Key="SurfaceColor">#1C1C22</Color>
    <Color x:Key="BorderColor">#26262E</Color>
    <Color x:Key="DividerColor">#1F1F26</Color>

    <!-- 文字层级 -->
    <Color x:Key="TextPrimaryColor">#ECECF0</Color>
    <Color x:Key="TextSecondaryColor">#9A9AA6</Color>
    <Color x:Key="TextDisabledColor">#63636E</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}"/>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLightColor}"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>

    <SolidColorBrush x:Key="SignalExcellentBrush" Color="{StaticResource SignalExcellentColor}"/>
    <SolidColorBrush x:Key="SignalGoodBrush" Color="{StaticResource SignalGoodColor}"/>
    <SolidColorBrush x:Key="SignalFairBrush" Color="{StaticResource SignalFairColor}"/>
    <SolidColorBrush x:Key="SignalWeakBrush" Color="{StaticResource SignalWeakColor}"/>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}"/>

    <!-- 以下原为渐变，现全部改为纯色，保持键名兼容 -->
    <SolidColorBrush x:Key="PrimaryGradientBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="AccentGradientBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="CardGradientBrush" Color="{StaticResource CardColor}"/>
    <SolidColorBrush x:Key="TitleGradientBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="WindowGradientBrush" Color="{StaticResource BackgroundColor}"/>

</ResourceDictionary>
