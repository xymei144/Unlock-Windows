<Window x:Class="UnlockServer.Views.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="提示"
        Width="440"
        MinWidth="400"
        MinHeight="200"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    
    <!--
      投影单独放在底层 Border（IsHitTestVisible=False），内容放上层。
      原因：WPF 中对元素设置 Effect 会使其渲染到独立离屏表面，
      导致该元素及子元素的鼠标命中测试失效（按钮点不动）。
    -->
    <Grid>
        <Border Background="{DynamicResource WindowSolidBrush}"
                CornerRadius="12"
                Margin="10"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                IsHitTestVisible="False"
                Focusable="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.4" Color="Black"/>
            </Border.Effect>
        </Border>

        <Border Background="{DynamicResource WindowSolidBrush}"
                CornerRadius="12"
                Margin="10"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- 内容区域 -->
            <Grid Grid.Row="0" Margin="24,24,24,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- 左侧图标 -->
                <Border x:Name="IconBorder"
                        Grid.Column="0"
                        Width="48" Height="48" 
                        CornerRadius="24"
                        VerticalAlignment="Top"
                        Margin="0,0,16,0">
                    <TextBlock x:Name="IconText"
                               FontSize="22" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"/>
                </Border>
                
                <!-- 右侧文字 -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <!-- 标题 -->
                    <TextBlock x:Name="TitleText"
                               Text="提示"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,6"/>
                    
                    <!-- 消息内容 -->
                    <TextBlock x:Name="MessageText"
                               Text="消息内容"
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               MaxWidth="340"/>

                    <!-- 需要输入时显示（重命名等） -->
                    <TextBox x:Name="InputBox"
                             Visibility="Collapsed"
                             Style="{StaticResource ModernTextBoxStyle}"
                             Margin="0,12,0,0"
                             MinWidth="300" MaxWidth="340"
                             HorizontalAlignment="Left"
                             KeyDown="InputBox_KeyDown"/>
                </StackPanel>
            </Grid>
            
            <!-- 按钮区域 -->
            <Border Grid.Row="1"
                    Background="Transparent"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="16,12">
                <Grid x:Name="ButtonPanel" HorizontalAlignment="Right">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- 取消按钮 -->
                    <Button x:Name="CancelButton"
                            Grid.Column="0"
                            Content="取消"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="CancelButton_Click"
                            MinWidth="80"
                            Padding="16,8"/>
                    
                    <!-- 确定按钮 -->
                    <Button x:Name="OkButton"
                            Grid.Column="2"
                            Content="确定"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="OkButton_Click"
                            MinWidth="80"
                            Padding="16,8"/>
                </Grid>
            </Border>
        </Grid>
        </Border>
    </Grid>
</Window>
