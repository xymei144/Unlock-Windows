<Window x:Class="UnlockServer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:UnlockServer.Converters"
        Title="{Binding WindowTitle}"
        Height="794" Width="640"
        MinHeight="794" MinWidth="640"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        FontFamily="{StaticResource DefaultFont}"
        Closing="Window_Closing">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <!--
      外壳分两层，原因：WPF 中对元素设置 Effect(DropShadowEffect) 会把它渲染到
      独立的离屏表面，从而使该元素及其全部子元素的鼠标命中测试失效
      （表现为窗口拖不动、按钮点不动）。
      因此把「投影」单独放在底层 Border 上（IsHitTestVisible=False，不参与命中），
      内容放在上层 Border，两者边距一致，视觉上仍是原来的「圆角 + 阴影」效果。
    -->
    <Grid>
        <!-- 底层：仅负责投影，不接收任何鼠标输入 -->
        <Border Background="{DynamicResource WindowBrush}"
                CornerRadius="{DynamicResource ShellRadius}"
                Margin="{DynamicResource ShellMargin}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                Effect="{DynamicResource ShellEffect}"
                IsHitTestVisible="False"
                Focusable="False"
                Panel.ZIndex="0"/>

        <!-- 上层：真正的窗口内容，正常参与命中测试 -->
        <Border Background="{DynamicResource WindowBrush}"
                CornerRadius="{DynamicResource ShellRadius}"
                Margin="{DynamicResource ShellMargin}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                Panel.ZIndex="1">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===== 标题栏 ===== -->
            <!-- Background="Transparent" 必不可少：Background=null 的 Grid 不参与鼠标命中，
                 点击标题栏空白会穿透到下层容器，导致窗口无法拖动 -->
            <Grid Grid.Row="0" Margin="20,14,14,12" Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource T.App.Title}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding AppVersion}" FontSize="11" Margin="7,1,0,0"
                               Foreground="{DynamicResource TextDisabledBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource TextDisabledBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMonitoring}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusText}" FontSize="11" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Button Content="─" Style="{StaticResource IconButtonStyle}" Click="MinimizeButton_Click" Margin="10,0,0,0"/>
                    <Button Content="✕" Style="{StaticResource IconButtonStyle}" Click="CloseButton_Click" Margin="2,0,0,0"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Height="1" Background="{DynamicResource DividerBrush}"/>

            <!-- ===== 状态区 ===== -->
            <Border Grid.Row="2" Margin="20,14,20,0" Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource T.Status.Current}" FontSize="11"
                                   Foreground="{DynamicResource TextDisabledBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Ellipse Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource ErrorBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDeviceInRange}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding CurrentRssi}" FontSize="14" FontWeight="SemiBold"
                                       TextWrapping="Wrap" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDeviceInRange}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Text="{Binding SetupHint}" FontSize="11" Foreground="{DynamicResource WarningBrush}"
                                   TextWrapping="Wrap" Margin="0,8,16,0"
                                   Visibility="{Binding HasSetupHint, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding ToggleMonitoringCommand}" Style="{StaticResource PrimaryButtonStyle}"
                                Padding="16,9" Margin="0,0,8,0"
                                Content="{Binding MonitorButtonText}"/>
                        <Button Content="{DynamicResource T.Btn.Lock}" Command="{Binding LockScreenCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" Padding="16,9"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== 标签页 + 内容 ===== -->
            <Grid Grid.Row="3" Margin="20,14,20,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{DynamicResource T.Tab.Devices}" Command="{Binding SelectTabCommand}" CommandParameter="0" Width="72">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource TabChipStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTabDevices}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="{DynamicResource T.Tab.Unlock}" Command="{Binding SelectTabCommand}" CommandParameter="1" Width="72">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource TabChipStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTabUnlock}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="{DynamicResource T.Tab.Settings}" Command="{Binding SelectTabCommand}" CommandParameter="2" Width="72">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource TabChipStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTabRules}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- ===================== 设备 ===================== -->
                <Grid Grid.Row="1" Margin="0,14,0,0"
                      Visibility="{Binding IsTabDevices, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="10">
                        <Grid>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding HasNoDevices, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{DynamicResource T.Dev.Empty.Title}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource T.Dev.Empty.Desc}" FontSize="11"
                                           Foreground="{DynamicResource TextDisabledBrush}" Margin="0,8,0,16"
                                           HorizontalAlignment="Center"/>
                                <Button Content="{DynamicResource T.Btn.AddDevice}" Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding SearchDeviceCommand}" Padding="20,9" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <ListBox ItemsSource="{Binding BoundDevices}" Style="{StaticResource ModernListBoxStyle}"
                                     Margin="6,4,6,4"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     Visibility="{Binding HasNoDevices, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="8" Height="8" Margin="4,0,12,0" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource TextDisabledBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsInRange}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="Medium"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock FontSize="11" Margin="0,3,0,0"
                                                           Foreground="{DynamicResource TextDisabledBrush}"
                                                           TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding TypeLabel, Mode=OneWay}"/>
                                                    <Run Text="  ·  "/>
                                                    <Run Text="{Binding Address, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="11"
                                                       VerticalAlignment="Center" Margin="10,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsInRange}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <CheckBox Grid.Column="3" IsChecked="{Binding Enabled}"
                                                      Style="{StaticResource ToggleSwitchStyle}"
                                                      VerticalAlignment="Center" Margin="4,0,10,0"
                                                      ToolTip="{DynamicResource T.Dev.EnableTip}"/>
                                            <Button Grid.Column="4" Content="{DynamicResource T.Btn.Rename}"
                                                    Style="{StaticResource GhostButtonStyle}"
                                                    Command="{Binding DataContext.RenameDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" VerticalAlignment="Center"/>
                                            <Button Grid.Column="5" Content="{DynamicResource T.Btn.Remove}"
                                                    Style="{StaticResource GhostButtonStyle}"
                                                    Command="{Binding DataContext.RemoveDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Content="{DynamicResource T.Dev.RequireAll}" Style="{StaticResource ToggleSwitchStyle}"
                                  IsChecked="{Binding Settings.RequireAllDevices}" VerticalAlignment="Center"
                                  Visibility="{Binding HasMultipleDevices, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <Button Grid.Column="1" Content="{DynamicResource T.Btn.AddDevice}" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding SearchDeviceCommand}" Padding="16,9"/>
                    </Grid>
                </Grid>

                <!-- ===================== 解锁 ===================== -->
                <Border Grid.Row="1" Margin="0,14,0,0" Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16"
                        Visibility="{Binding IsTabUnlock, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="{DynamicResource T.Unlock.Section}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{DynamicResource T.Unlock.Desc}"
                                       FontSize="11" Foreground="{DynamicResource TextDisabledBrush}"
                                       TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource T.Unlock.Username}" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding Settings.Username, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource T.Unlock.Password}" Style="{StaticResource LabelStyle}"/>
                                <PasswordBox x:Name="PasswordBox" Style="{StaticResource ModernPasswordBoxStyle}"
                                             PasswordChanged="PasswordBox_PasswordChanged"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Grid.Row="2" Text="{Binding LocalUnlockStatus}" FontSize="11" Margin="0,12,0,0"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLocalUnlockReady}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <CheckBox Grid.Row="3" Content="{DynamicResource T.Unlock.Prefer}" Style="{StaticResource ToggleSwitchStyle}"
                                  IsChecked="{Binding Settings.UseLocalUnlock}" Margin="0,12,0,0"/>

                        <UniformGrid Grid.Row="4" Columns="3" Margin="0,14,0,0" Height="32">
                            <Button Content="{Binding InstallButtonText}" Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding InstallLocalUnlockCommand}" Margin="0,0,4,0"/>
                            <Button Content="{DynamicResource T.Btn.Uninstall}" Style="{StaticResource SecondaryButtonStyle}"
                                    Foreground="{DynamicResource ErrorBrush}"
                                    Command="{Binding UninstallLocalUnlockCommand}"
                                    IsEnabled="{Binding CanUninstallLocalUnlock}" Margin="4,0"/>
                            <Button Content="{DynamicResource T.Btn.TestUnlock}" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding TestUnlockCommand}"
                                    IsEnabled="{Binding CanTestUnlock}" Margin="4,0,0,0"/>
                        </UniformGrid>

                        <Border Grid.Row="5" Height="1" Background="{DynamicResource DividerBrush}" Margin="0,18,0,14"/>

                        <TextBlock Grid.Row="6" Text="{DynamicResource T.Remote.Section}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>

                        <Grid Grid.Row="7" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding Settings.ServerIp, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     ToolTip="{DynamicResource T.Remote.IpTip}"/>
                            <TextBox Grid.Column="2" Text="{Binding Settings.ServerPort, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     ToolTip="{DynamicResource T.Remote.PortTip}"/>
                            <Button Grid.Column="3" Content="{DynamicResource T.Btn.Test}" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding TestServerCommand}" Margin="8,0,0,0"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ===================== 设置 ===================== -->
                <Border Grid.Row="1" Margin="0,14,0,0" Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20,18"
                        Visibility="{Binding IsTabRules, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- 外观 -->
                            <TextBlock Text="{DynamicResource T.Group.Appearance}" Style="{StaticResource GroupLabelStyle}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource T.Appearance.Theme}" Style="{StaticResource SettingLabelStyle}"
                                           MinWidth="60"/>
                                <Border Grid.Column="1" Style="{StaticResource SegmentGroupStyle}"
                                        HorizontalAlignment="Right">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="ThemeDarkRadio" Tag="dark" GroupName="AppTheme"
                                                     Content="{DynamicResource T.Theme.Dark}"
                                                     Style="{StaticResource SegmentItemStyle}" Checked="ThemeRadio_Checked"/>
                                        <RadioButton x:Name="ThemeLightRadio" Tag="light" GroupName="AppTheme"
                                                     Content="{DynamicResource T.Theme.Light}"
                                                     Style="{StaticResource SegmentItemStyle}" Checked="ThemeRadio_Checked"/>
                                        <RadioButton x:Name="ThemeSystemRadio" Tag="system" GroupName="AppTheme"
                                                     Content="{DynamicResource T.Theme.System}"
                                                     Style="{StaticResource SegmentItemStyle}" Checked="ThemeRadio_Checked"/>
                                        <RadioButton x:Name="ThemeAcrylicRadio" Tag="acrylic" GroupName="AppTheme"
                                                     Content="{DynamicResource T.Theme.Acrylic}"
                                                     Style="{StaticResource SegmentItemStyle}" Checked="ThemeRadio_Checked"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource T.Appearance.Language}" Style="{StaticResource SettingLabelStyle}"
                                           MinWidth="60"/>
                                <Border Grid.Column="1" Style="{StaticResource SegmentGroupStyle}"
                                        HorizontalAlignment="Right">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="LangZhRadio" Tag="zh" GroupName="AppLang"
                                                     Content="{DynamicResource T.Lang.Zh}"
                                                     Style="{StaticResource SegmentItemStyle}" Checked="LangRadio_Checked"/>
                                        <RadioButton x:Name="LangEnRadio" Tag="en" GroupName="AppLang"
                                                     Content="{DynamicResource T.Lang.En}"
                                                     Style="{StaticResource SegmentItemStyle}" Checked="LangRadio_Checked"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,16,0,14"/>

                            <!-- 开关 -->
                            <TextBlock Text="{DynamicResource T.Group.Switches}" Style="{StaticResource GroupLabelStyle}"/>
                            <UniformGrid Columns="2">
                                <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                          IsChecked="{Binding Settings.AutoLock}" Margin="0,0,16,13">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{DynamicResource T.Rule.AutoLock}" VerticalAlignment="Center"/>
                                        <Border Style="{StaticResource HelpDotStyle}" ToolTip="{DynamicResource T.Help.AutoLock}">
                                            <TextBlock Style="{StaticResource HelpDotTextStyle}"/>
                                        </Border>
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                          IsChecked="{Binding Settings.AutoUnlock}" Margin="0,0,0,13">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{DynamicResource T.Rule.AutoUnlock}" VerticalAlignment="Center"/>
                                        <Border Style="{StaticResource HelpDotStyle}" ToolTip="{DynamicResource T.Help.AutoUnlock}">
                                            <TextBlock Style="{StaticResource HelpDotTextStyle}"/>
                                        </Border>
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                          IsChecked="{Binding Settings.AutoStart}" Margin="0,0,16,13">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{DynamicResource T.Rule.AutoStart}" VerticalAlignment="Center"/>
                                        <Border Style="{StaticResource HelpDotStyle}" ToolTip="{DynamicResource T.Help.AutoStart}">
                                            <TextBlock Style="{StaticResource HelpDotTextStyle}"/>
                                        </Border>
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                          IsChecked="{Binding Settings.ManualLock}" Margin="0,0,0,13">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{DynamicResource T.Rule.ManualLock}" VerticalAlignment="Center"/>
                                        <Border Style="{StaticResource HelpDotStyle}" ToolTip="{DynamicResource T.Help.ManualLock}">
                                            <TextBlock Style="{StaticResource HelpDotTextStyle}"/>
                                        </Border>
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                          IsChecked="{Binding Settings.ManualUnlock}" Margin="0,0,16,13">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{DynamicResource T.Rule.ManualUnlock}" VerticalAlignment="Center"/>
                                        <Border Style="{StaticResource HelpDotStyle}" ToolTip="{DynamicResource T.Help.ManualUnlock}">
                                            <TextBlock Style="{StaticResource HelpDotTextStyle}"/>
                                        </Border>
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                          IsChecked="{Binding Settings.LockOnlyWhenIdle}" Margin="0,0,0,13">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{DynamicResource T.Rule.IdleOnly}" VerticalAlignment="Center"/>
                                        <Border Style="{StaticResource HelpDotStyle}" ToolTip="{DynamicResource T.Help.IdleOnly}">
                                            <TextBlock Style="{StaticResource HelpDotTextStyle}"/>
                                        </Border>
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                          IsChecked="{Binding Settings.LockWhenSeen}" Margin="0,0,16,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{DynamicResource T.Rule.LockWhenSeen}" VerticalAlignment="Center"/>
                                        <Border Style="{StaticResource HelpDotStyle}" ToolTip="{DynamicResource T.Help.LockWhenSeen}">
                                            <TextBlock Style="{StaticResource HelpDotTextStyle}"/>
                                        </Border>
                                    </StackPanel>
                                </CheckBox>
                            </UniformGrid>

                            <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,16,0,14"/>

                            <!-- 时间与信号 -->
                            <TextBlock Text="{DynamicResource T.Group.TimeAndSignal}" Style="{StaticResource GroupLabelStyle}"/>

                            <UniformGrid Columns="2">
                                <Border Style="{StaticResource SettingFieldStyle}" Margin="0,0,16,14">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{DynamicResource T.Field.LockDelay}" Style="{StaticResource SettingLabelStyle}"/>
                                        <Border Style="{StaticResource HelpDotStyle}" ToolTip="{DynamicResource T.Help.LockDelay}">
                                            <TextBlock Style="{StaticResource HelpDotTextStyle}"/>
                                        </Border>
                                        <TextBox Text="{Binding Settings.LockDelay, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource SettingValueBoxStyle}"/>
                                        <TextBlock Text="{DynamicResource T.Unit.Second}" Style="{StaticResource SettingUnitStyle}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SettingFieldStyle}" Margin="0,0,0,14">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{DynamicResource T.Field.IdleSeconds}" Style="{StaticResource SettingLabelStyle}"/>
                                        <Border Style="{StaticResource HelpDotStyle}" ToolTip="{DynamicResource T.Help.IdleSeconds}">
                                            <TextBlock Style="{StaticResource HelpDotTextStyle}"/>
                                        </Border>
                                        <TextBox Text="{Binding Settings.IdleLockSeconds, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource SettingValueBoxStyle}"/>
                                        <TextBlock Text="{DynamicResource T.Unit.Second}" Style="{StaticResource SettingUnitStyle}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SettingFieldStyle}" Margin="0,0,16,14">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{DynamicResource T.Field.UnlockDelay}" Style="{StaticResource SettingLabelStyle}"/>
                                        <Border Style="{StaticResource HelpDotStyle}" ToolTip="{DynamicResource T.Help.UnlockDelay}">
                                            <TextBlock Style="{StaticResource HelpDotTextStyle}"/>
                                        </Border>
                                        <TextBox Text="{Binding Settings.UnlockDelay, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource SettingValueBoxStyle}"/>
                                        <TextBlock Text="{DynamicResource T.Unit.Second}" Style="{StaticResource SettingUnitStyle}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SettingFieldStyle}" Margin="0,0,0,14">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{DynamicResource T.Field.ActionWarn}" Style="{StaticResource SettingLabelStyle}"/>
                                        <Border Style="{StaticResource HelpDotStyle}" ToolTip="{DynamicResource T.Help.ActionWarn}">
                                            <TextBlock Style="{StaticResource HelpDotTextStyle}"/>
                                        </Border>
                                        <TextBox Text="{Binding Settings.ActionWarnSeconds, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource SettingValueBoxStyle}"/>
                                        <TextBlock Text="{DynamicResource T.Unit.Second}" Style="{StaticResource SettingUnitStyle}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SettingFieldStyle}" Margin="0,0,16,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{DynamicResource T.Field.RssiThreshold}" Style="{StaticResource SettingLabelStyle}"/>
                                        <Border Style="{StaticResource HelpDotStyle}" ToolTip="{DynamicResource T.Help.RssiThreshold}">
                                            <TextBlock Style="{StaticResource HelpDotTextStyle}"/>
                                        </Border>
                                        <TextBox Text="{Binding Settings.RssiThreshold, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource SettingValueBoxStyle}"/>
                                        <TextBlock Text="{DynamicResource T.Unit.dBm}" Style="{StaticResource SettingUnitStyle}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SettingFieldStyle}" Margin="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{DynamicResource T.Field.Hysteresis}" Style="{StaticResource SettingLabelStyle}"/>
                                        <Border Style="{StaticResource HelpDotStyle}" ToolTip="{DynamicResource T.Help.Hysteresis}">
                                            <TextBlock Style="{StaticResource HelpDotTextStyle}"/>
                                        </Border>
                                        <TextBox Text="{Binding Settings.HysteresisDb, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource SettingValueBoxStyle}" Width="40"/>
                                        <TextBlock Text="{DynamicResource T.Unit.dB}" Style="{StaticResource SettingUnitStyle}" Margin="4,0,10,0"/>
                                        <TextBox Text="{Binding Settings.PresenceTimeout, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource SettingValueBoxStyle}" Width="40"/>
                                        <TextBlock Text="{DynamicResource T.Unit.Second}" Style="{StaticResource SettingUnitStyle}"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
        </Border>
    </Grid>
</Window>
