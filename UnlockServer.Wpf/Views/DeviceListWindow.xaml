<Window x:Class="UnlockServer.Views.DeviceListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:UnlockServer.Converters"
        mc:Ignorable="d"
        Title="Search Bluetooth devices" 
        Height="640" Width="460" 
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        Closing="Window_Closing">
    
    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:RssiToColorConverter x:Key="RssiToColorConverter"/>
        <converters:RssiToWidthConverter x:Key="RssiToWidthConverter"/>
    </Window.Resources>
    
    <!--
      投影单独放在底层 Border（IsHitTestVisible=False），内容放上层。
      原因：WPF 中对元素设置 Effect 会使其渲染到独立离屏表面，
      导致该元素及子元素的鼠标命中测试失效。
    -->
    <Grid>
        <Border Background="{DynamicResource WindowSolidBrush}"
                CornerRadius="12"
                Margin="10"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                IsHitTestVisible="False"
                Focusable="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.3" Color="Black"/>
            </Border.Effect>
        </Border>

        <Border Background="{DynamicResource WindowSolidBrush}"
                CornerRadius="12"
                Margin="10"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- 自定义标题栏 -->
            <Border Grid.Row="0" Background="{DynamicResource WindowSolidBrush}"
                    CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 标题 -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource T.Scan.Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{DynamicResource T.Scan.Subtitle}" FontSize="11" Foreground="{DynamicResource TextDisabledBrush}" Margin="0,3,0,0"/>
                    </StackPanel>

                    <!-- 关闭按钮 -->
                    <Button Grid.Column="1" Content="✕"
                            Style="{StaticResource IconButtonStyle}"
                            Click="CloseButton_Click"
                            Width="30" Height="30" FontSize="12"/>
                </Grid>
            </Border>

            <Border Grid.Row="0" Height="1" Background="{DynamicResource DividerBrush}" VerticalAlignment="Bottom"/>
            
            <!-- 筛选区域 -->
            <Border Grid.Row="1" Margin="16,12,16,0">
                <StackPanel>
                    <!-- 蓝牙类型选择 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <RadioButton Content="{DynamicResource T.Scan.FilterAll}" 
                                     Style="{StaticResource ModernRadioButtonStyle}"
                                     IsChecked="{Binding IsAllBluetooth}"
                                     FontSize="11" Padding="8,6"
                                     Margin="0,0,6,0"/>
                        <RadioButton Content="{DynamicResource T.Scan.FilterClassic}" 
                                     Style="{StaticResource ModernRadioButtonStyle}"
                                     IsChecked="{Binding IsClassicBluetooth}"
                                     FontSize="11" Padding="8,6"
                                     Margin="0,0,6,0"/>
                        <RadioButton Content="BLE" 
                                     Style="{StaticResource ModernRadioButtonStyle}"
                                     IsChecked="{Binding IsBLE}"
                                     FontSize="11" Padding="8,6"/>
                        
                        <Button Content="{DynamicResource T.Btn.Refresh}"
                                Style="{StaticResource IconButtonStyle}"
                                Command="{Binding RefreshCommand}"
                                ToolTip="{DynamicResource T.Scan.RefreshTip}"
                                Width="34" Height="30"
                                Margin="8,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding ScanHint}" FontSize="10"
                               Foreground="{DynamicResource TextDisabledBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,8"/>
                    
                    <!-- 搜索框 -->
                    <Border Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Height="34">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 输入框 -->
                            <TextBox Grid.Column="1"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     CaretBrush="{DynamicResource PrimaryBrush}"
                                     FontSize="12"
                                     VerticalContentAlignment="Center"
                                     Padding="0,0,10,0"/>

                            <!-- Placeholder -->
                            <TextBlock Grid.Column="1"
                                       Text="{DynamicResource T.Scan.SearchPlaceholder}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Foreground="{DynamicResource TextDisabledBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchText}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                    
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding ManualAddress, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 ToolTip="{DynamicResource T.Scan.ManualTip}"
                                 />
                        <Button Grid.Column="2" Content="{DynamicResource T.Btn.ManualBind}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding UseManualAddressCommand}"
                                Padding="10,6" FontSize="11"/>
                    </Grid>
                </StackPanel>
            </Border>
            
            <!-- 设备列表 -->
            <Border Grid.Row="2" Margin="16,12,16,0" 
                    Background="{DynamicResource CardBrush}" 
                    CornerRadius="10"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1">
                <Grid>
                    <!-- 扫描中提示（仅列表为空时显示） -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding ShowScanningHint, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{DynamicResource T.Scan.Scanning}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource T.Scan.EnableBt}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextDisabledBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                    
                    <!-- 设备列表 -->
                    <ListBox ItemsSource="{Binding Devices}"
                             SelectedItem="{Binding SelectedDevice}"
                             Style="{StaticResource ModernListBoxStyle}"
                             Margin="6"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 在线指示点 -->
                                    <Ellipse Grid.Column="0"
                                             Width="8" Height="8"
                                             Fill="{Binding Rssi, Converter={StaticResource RssiToColorConverter}}"
                                             VerticalAlignment="Center"
                                             Margin="6,0,12,0"/>
                                    
                                    <!-- 设备信息 -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayName}" 
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontSize="13"
                                                       FontWeight="Medium"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="180"/>
                                            <!-- 已配对标签 -->
                                            <Border Background="{DynamicResource PrimaryBrush}" 
                                                    CornerRadius="3" Padding="4,1" Margin="6,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding IsPaired, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="{DynamicResource T.Scan.Paired}" FontSize="9" Foreground="White"/>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Border Background="{DynamicResource SurfaceBrush}" 
                                                    CornerRadius="3" Padding="5,2"
                                                    ToolTip="{DynamicResource T.Scan.TypeTip}">
                                                <TextBlock Text="{Binding Type}" 
                                                           FontSize="10"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Border>
                                            <TextBlock Text="{Binding Address}" 
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextDisabledBrush}"
                                                       Margin="6,0,0,0"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                    
                                    <!-- 信号强度 -->
                                    <StackPanel Grid.Column="2" 
                                                VerticalAlignment="Center" 
                                                HorizontalAlignment="Right"
                                                Width="65">
                                        <TextBlock Text="{Binding RssiDisplay}" 
                                                   Foreground="{Binding Rssi, Converter={StaticResource RssiToColorConverter}}"
                                                   FontWeight="Bold"
                                                   FontSize="12"
                                                   HorizontalAlignment="Right"/>
                                        <!-- 信号强度条 -->
                                        <Grid Height="4" Margin="0,4,0,0">
                                            <Border Background="{DynamicResource SurfaceBrush}" 
                                                    CornerRadius="2"/>
                                            <Border Background="{Binding Rssi, Converter={StaticResource RssiToColorConverter}}" 
                                                    CornerRadius="2"
                                                    HorizontalAlignment="Left"
                                                    Width="{Binding Rssi, Converter={StaticResource RssiToWidthConverter}, ConverterParameter=65}"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            
            <!-- 底部按钮 -->
            <Grid Grid.Row="3" Margin="16,12,16,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Button Grid.Column="0" 
                        Content="{DynamicResource T.Btn.Cancel}" 
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="CancelButton_Click"
                        Padding="0,10"/>
                
                <Button Grid.Column="2"
                        Content="{DynamicResource T.Btn.ConfirmSelect}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding SelectCommand}"
                        Padding="0,10"/>
            </Grid>
        </Grid>
        </Border>
    </Grid>
</Window>
